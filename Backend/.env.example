# Copy to .env. Leave the key empty to run the backend demo.
# The base URL must expose an OpenAI-compatible /chat/completions API.
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# Disable thinking for short NPC dialogue. Leave empty for other providers.
LLM_ENABLE_THINKING=false
LLM_TIMEOUT=25
TOWN_PORT=8000

# OpenAI example (clear LLM_ENABLE_THINKING):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Ollama example (run the model locally first):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
# LLM_ENABLE_THINKING=
